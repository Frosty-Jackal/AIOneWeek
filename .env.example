# 复制为 .env 后填写。真实 .env 不入库（见 .gitignore）

# DeepSeek —— 走 Anthropic 兼容端点；联网搜索仅该端点可用，见 Spec1 §5.2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRY=2
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_SEARCH_MAX_USES=3

# 加密与会话
# 生成 FERNET_KEY：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 生成 SESSION_SECRET：python -c "import secrets;print(secrets.token_urlsafe(32))"
FERNET_KEY=
SESSION_SECRET=

# 邮件（QQ 邮箱，AUTH_CODE 是「授权码」不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=frostyj@qq.com
SMTP_AUTH_CODE=
SMTP_FROM_NAME=AIOneWeek
# 新用户注册通知的收件地址；留空 = 关闭该通知（Spec3 §10）
REGISTER_NOTIFY_EMAIL=frostyj@qq.com

# 业务
DB_PATH=./data/aioneek.db
ADMIN_EMAIL=frostyj@qq.com
# 首次启动种子管理员用，2-8 位数字+英文
ADMIN_INIT_PASSWORD=
COST_DAILY_LIMIT_CNY=2.0
USD_CNY=7.1
WEEK_WINDOW_DAYS=7
MAX_ITEMS_PER_DAY=5
CODE_TTL_SECONDS=600
CODE_RESEND_INTERVAL=120
